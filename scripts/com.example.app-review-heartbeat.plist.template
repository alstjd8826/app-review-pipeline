<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd 템플릿. 쓰기 전에 두 곳을 바꾼다.
    __PROJECT_DIR__  → 프로젝트 절대경로
    com.example.*    → 원하는 라벨

  ⚠️ 디렉토리를 옮기면 이 경로가 깨진다.
     bootout → 이동 → 경로 수정 → bootstrap 순서로 한다.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.app-review-heartbeat</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/heartbeat.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- 매주 월요일 오전 10시 30분. 본 파이프라인(10시)이 돈 뒤에 상태를 알린다 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>10</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/heartbeat.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/heartbeat.err.log</string>
</dict>
</plist>
